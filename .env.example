# ════════════════════════════════════════════════════════════════════
#  Cabin Assistant — runtime configuration
#  Copy to .env and fill in what you have. Every service has a keyless
#  fallback except the LLM (needs one key) and cloud STT (needs one key).
# ════════════════════════════════════════════════════════════════════

# ── Simulation (no keys, no network) ────────────────────────────────
SIMULATION=false                    # true = offline brain, maps, search, weather, speech
SIM_AUTOPILOT=false                 # true = guided tour of every feature on launch
SIM_VOICE=auto                      # auto | system (macOS say / espeak) | murmur | silent
SIM_MAP_TILES=offline               # offline (procedural) | online (CARTO tiles, no key, needs internet)
SYSTEM_TTS_VOICE=                   # e.g. Samantha (macOS `say -v ?` lists voices)

# ── Assistant ───────────────────────────────────────────────────────
ASSISTANT_NAME=Aria
DRIVER_NAME=Driver
UNITS=imperial                      # imperial | metric
LOCALE=en-US

# Conversation: handsfree = always listening (VAD), tap = tap orb to talk
LISTEN_MODE=handsfree
WAKE_WORD=hey nova                    # utterances must begin with it, except follow-ups and a pending one-time code
WAKE_WINDOW_S=1.2                   # seconds of speech transcribed to look for the phrase
BARGE_IN=true                       # talk over the assistant to interrupt

# ── Language model (pick one provider) ──────────────────────────────
LLM_PROVIDER=openrouter             # openrouter | openai | gemini | xai | anthropic | groq
LLM_MODEL=                          # blank = provider default below
LLM_TEMPERATURE=                    # blank = provider default
LLM_REASONING_EFFORT=none           # minimal | low | medium | high (reasoning models only)

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Speech to text ──────────────────────────────────────────────────
STT_PROVIDER=auto                   # auto | parakeet | deepgram | openai | groq (auto prefers on-device Parakeet when installed)
ASR_GATE=true                      # parakeet: drop junk transcripts and ask "Sorry, say that again?" on implausible ones
STT_PARTIALS=false                  # parakeet: live partial transcript every ~1.2 s of audio
PARAKEET_LIB=                       # blank = ~/.local/share/drive-os/models/parakeet/libparakeet.so
PARAKEET_MODEL=                     # blank = ~/.local/share/drive-os/models/parakeet/tdt_ctc-110m-q8_0.gguf
DEEPGRAM_API_KEY=                   # live streaming partials (best UX)
DEEPGRAM_STT_MODEL=nova-3
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Text to speech ──────────────────────────────────────────────────
TTS_PROVIDER=auto                   # auto | phonon | elevenlabs | openai | deepgram | system (auto: Phonon when cached)
PHONON_VOICE=                       # blank = model default voice
TTS_CLAUSE_PAUSE_MS=220             # Phonon: silence after an em dash, semicolon, colon or ellipsis; 0 = off
PHONON_DURATION_DELTA=-0.25         # negative = faster speech; 0 = original rate
ELEVENLABS_API_KEY=                 # returns char timings → most accurate lip sync
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Warm, calm, concise in-car assistant. Natural pace.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# ── Maps, places, routing ───────────────────────────────────────────
MAP_PROVIDER=auto                   # auto | mapbox | osm
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/navigation-night-v1
GOOGLE_MAPS_API_KEY=                # Places (New) text search for POIs, optional

# ── Web search ──────────────────────────────────────────────────────
SEARCH_PROVIDER=auto                # auto | tavily | brave | serper | wikipedia
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ── Weather & EV charging ───────────────────────────────────────────
OPENWEATHER_API_KEY=                # optional; Open-Meteo is used keyless
OPENCHARGEMAP_API_KEY=              # optional; falls back to place search

# ── Vehicle (simulated CAN signals until wired to the vehicle bus) ──
VEHICLE_NAME=Model Y
# No satellite fix: the DriveOS simulated place. Shops and the map are centred here.
VEHICLE_LAT=37.4419
VEHICLE_LON=-122.1430
VEHICLE_PLACE=Palo Alto, California
VEHICLE_BATTERY_PCT=82
VEHICLE_RANGE_FULL_MI=310
VEHICLE_CABIN_TEMP_F=72

# ── Audio ───────────────────────────────────────────────────────────
AUDIO_INPUT_DEVICE=                 # name substring or index (e.g. XVF3800); blank = default
AUDIO_OUTPUT_DEVICE=
NOVA_AUDIO_MUTE=                    # 1/true/yes = no speaker output (tests, CI); playback clock and AEC reference keep running
AUDIO_SHARED=true                   # prefer the PipeWire source over raw hw: so other apps (screen share) can use the mic too
VAD_SENSITIVITY=0.6                 # 0..1, higher = triggers on quieter speech
VAD_END_SILENCE_MS=700              # upper bound of silence that ends a turn
VAD_ENGINE=auto                     # auto | silero | energy (auto = Silero + Smart Turn when the ONNX models exist)
VAD_MIN_SILENCE_MS=240              # silero: pause after which Smart Turn may end the turn early
SILERO_MODEL=                       # blank = drive-os models/silero_vad.onnx
SMART_TURN_MODEL=                   # blank = drive-os models/smart-turn-v3.2-cpu.onnx
FRONTEND_THREAD=on                 # on | off: run VAD / Smart Turn on a worker thread (off = synchronous, deterministic)
AEC=auto                           # auto | on | off: software echo canceller (auto = on unless the mic is an XVF3800/reSpeaker with hardware AEC)
AEC_DELAY_MS=                      # blank = estimate the speaker-to-mic delay from playback; a number fixes it
DRIVER_GATE=auto                    # auto | doa | near_field | off: only the driver starts a turn (auto = XVF3800 direction of arrival, else near-field level)
DRIVER_BEARING_DEG=0                # XVF3800 azimuth of the driver seat, degrees
DRIVER_ZONE_DEG=40                  # accepted spread around the bearing (plus or minus)
NEAR_FIELD_DB=18                    # near-field: dB a frame must stand above the cabin noise floor
AEC_FALLBACK=half_duplex           # half_duplex | none: mic closed while Nova speaks when the echo cannot be cancelled

# ── App ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# NOVA_PLUGINS_OFF=                   # comma list of plugins to switch off, e.g. nav,agents
HTTP_TIMEOUT_S=20
# Per-turn time budget for compound requests: after this, Nova speaks the templated merge sentence.
TURN_BUDGET_S=6

# ── GPS ─────────────────────────────────────────────────────────────
GPS_SOURCE=auto                     # auto (gpsd, then serial) | gpsd | serial:/dev/ttyUSB0@9600 | replay:<file> | sim ; --sim stays simulated unless set
GPS_FIX_TIMEOUT_S=30                # no fix for this long -> simulated position with a badge, sources keep retrying
GPS_SERIAL_DEVICE=/dev/ttyUSB0      # used by GPS_SOURCE=auto; a running gpsd owns this port, so the serial fallback only works with gpsd stopped
GPS_BAUD=9600

# ── Thermal ladder ──────────────────────────────────────────────────
THERMAL=on                          # on | off: cap avatar fps, then sentence length, then pause the live map as the SoC heats up
THERMAL_LEVELS=78,81,84             # degrees C at which each step engages
THERMAL_HYSTERESIS_C=3              # a step releases this far below its threshold

# ── Agents ──────────────────────────────────────────────────────────
AGENT_TIMEOUT_S=6                   # per-agent time budget inside a tool round; a slow agent returns error "timeout" and never stops the others
EXA_MCP_CMD=                        # e.g. npx -y exa-mcp-server ; research agent uses Exa through this MCP server, empty -> built-in web search
EXA_API_KEY=                        # passed to the MCP server's environment only

# ── Telemetry ───────────────────────────────────────────────────────
TELEMETRY=on                        # on | off: app/conversation/tools/perf JSONL + telemetry.db under $NOVA_CABIN_DATA/logs (default ~/.local/share/nova-cabin/logs); keys, PANs, OTP codes, addresses and biometric scores are redacted at the sink
TELEMETRY_MAX_MB=500                # rotate a stream's file at this size
TELEMETRY_MAX_DAYS=14               # rotate at this age; archives older than this are deleted
TELEMETRY_QUEUE=10000               # writer queue depth; overflow drops records and counts them, it never blocks the app
TELEMETRY_SQLITE=on                 # mirror turns / tools / llm into telemetry.db
TELEMETRY_SAMPLER=on                # on | off: resource sampler (CPU per core, memory, temperature, throttle, NPU) into perf.jsonl and the Diagnostics panel
TELEMETRY_SAMPLE_S=5                # sampler interval in seconds

# ── Memory ──────────────────────────────────────────────────────────
MEMORY=on                           # on | off: persist every turn (text, tool calls, results, cards) in memory.db under $NOVA_CABIN_DATA and resume the last session; off = in-process history only
MEMORY_BUDGET_TOKENS=3500           # est. 4 chars/token; older turns are summarised once the prompt exceeds this
MEMORY_RESUME_HOURS=4               # a session idle longer than this starts fresh
DRIVER_ID=driver                    # key for the session history

# ── Places, guidance, map service ───────────────────────────────────
PLACES_LIVE=on                      # on | off: live place search (off = bundled/offline places only)
PLACES_RADIUS_KM=15                 # offline catalogue: ignore places farther than this from the car
NAV_GUIDANCE=on                     # on | off: spoken turn-by-turn guidance while navigating
MAP_SERVICE=off                     # on | off: separate map tile service process (off = in-process map)

# Speaker loudness: software gain with a soft limiter (1.0 = unchanged). Raise for a quiet speaker.
PLAYBACK_GAIN=2.2
MAP_HEADING_UP=off                  # on: the nav map turns with the car; off: north stays up

# Display. Leave blank: started over SSH on the Pi, the app finds the running desktop by itself.
XDG_RUNTIME_DIR=                    # e.g. /run/user/1000
WAYLAND_DISPLAY=                    # e.g. wayland-0
QT_QPA_PLATFORM=                    # wayland | xcb | eglfs
